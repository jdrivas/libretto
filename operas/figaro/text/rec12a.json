  {"characters": ["CHERUBINO"], "phrases": [
   ["La patente.", "The commission."]]},
  {"characters": ["LA CONTESSA"], "phrases": [
   ["Che sollecita gente!", "What prompt people!"]]},
  {"characters": ["CHERUBINO"], "phrases": [
   ["L’ebbi or or", "I had it just now"], ["da Basilio.", "from Basilio."]]},
  {"characters": ["LA CONTESSA"], "phrases": [
   ["Dalla fretta", "From the haste"], ["obbliato hanno il sigillo.", "forgotten they have the seal."]]},
  {"characters": ["SUSANNA"], "phrases": [
